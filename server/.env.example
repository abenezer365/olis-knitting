# ──────────────────────────────────────────────────────────────
# Oli's Knitwear API — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# App URL used in transactional emails (order tracking links etc.)
APP_URL=http://localhost:5173

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ── Database (matches docker-compose service `db`) ──
DB_HOST=db
DB_PORT=3306
DB_USER=olis
DB_PASSWORD=olis_password
DB_NAME=olis_knitting
DB_CONNECTION_LIMIT=10

# ── CORS ──
# Comma-separated list of allowed browser origins (admin + client).
# Leave EMPTY only in local dev to allow all origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Email (Gmail app password) ──
EMAIL=
PASSWORD=
MAIL_FROM="Oli's Knitwear <no-reply@olisknitwear.com>"

# ── Cloudinary (product image storage) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=olis-knitwear/products

# ── Seeder (dev only) ──
SEED_ADMIN_EMAIL=admin@olisknitwear.com
SEED_ADMIN_PASSWORD=Admin@12345
